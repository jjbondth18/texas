# Local development can keep HOST=127.0.0.1.
# Cloud VM / VPS deployment should bind to HOST=0.0.0.0 behind a firewall or proxy.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# SQLite is acceptable for early single-instance testing.
# Multi-instance or formal operations should migrate to PostgreSQL.
DATABASE_DRIVER=sqlite
SQLITE_PATH=/var/lib/texas-poker/texas.sqlite
DATABASE_URL=

# WARNING: ADMIN_LOCAL_ONLY=false exposes unauthenticated local debug pages
# if the port is reachable. Production should add auth or keep admin firewalled.
ADMIN_ENABLED=true
ADMIN_LOCAL_ONLY=false
DEV_SHOW_PRIVATE_CARDS=false

# DEV ONLY. Enables Store mock chip/gem packs for local testing.
# Keep false in formal production; real purchases need platform receipt validation.
ALLOW_MOCK_PURCHASES=false
# INTERNAL BETA ONLY. Comma-separated SteamIDs allowed to use Store test purchases
# when ALLOW_MOCK_PURCHASES=true. Leave empty for production.
MOCK_PURCHASE_ALLOWED_STEAM_IDS=
# INTERNAL BETA ONLY. Comma-separated SteamIDs allowed to import legacy replay
# entitlements after local cache verification. Leave empty for production.
LEGACY_REPLAY_IMPORT_ALLOWED_STEAM_IDS=

# Steam identity auth scaffold. Keep disabled until the real Steam AppID and
# Publisher Web API key are configured and ticket verification is tested.
STEAM_AUTH_MODE=disabled
STEAM_APP_ID=
STEAM_WEB_API_PUBLISHER_KEY=
STEAM_AUTH_IDENTITY=texas-server-v1
